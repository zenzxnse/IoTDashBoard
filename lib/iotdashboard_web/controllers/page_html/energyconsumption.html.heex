<div class="min-h-screen bg-gradient-to-br from-indigo-900 via-purple-800 to-pink-700 text-white py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
            <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl mb-3 text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-blue-400">
                Energy Consumption Dashboard
            </h1>
            <p class="text-xl text-indigo-200 max-w-3xl mx-auto">
                Monitor and analyze your energy usage patterns and pollution metrics
            </p>
        </div>
        
        <!-- Stats Cards Row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
            <div class="bg-white/10 backdrop-blur-lg rounded-xl shadow-xl p-6 border border-white/20 hover:transform hover:scale-105 transition-all">
                <div class="flex items-center">
                    <div class="p-3 rounded-full bg-teal-500/30 text-teal-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-indigo-200">Current Usage</p>
                        <p class="text-2xl font-bold text-white">7.2 kWh</p>
                    </div>
                </div>
                <div class="mt-4">
                    <div class="h-2 bg-gray-600 rounded-full">
                        <div class="h-2 bg-gradient-to-r from-teal-400 to-blue-500 rounded-full" style="width: 72%"></div>
                    </div>
                </div>
            </div>
            
            <div class="bg-white/10 backdrop-blur-lg rounded-xl shadow-xl p-6 border border-white/20 hover:transform hover:scale-105 transition-all">
                <div class="flex items-center">
                    <div class="p-3 rounded-full bg-blue-500/30 text-blue-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-indigo-200">Monthly Average</p>
                        <p class="text-2xl font-bold text-white">215 kWh</p>
                    </div>
                </div>
                <div class="mt-4">
                    <div class="h-2 bg-gray-600 rounded-full">
                        <div class="h-2 bg-gradient-to-r from-blue-400 to-indigo-500 rounded-full" style="width: 65%"></div>
                    </div>
                </div>
            </div>
            
            <div class="bg-white/10 backdrop-blur-lg rounded-xl shadow-xl p-6 border border-white/20 hover:transform hover:scale-105 transition-all">
                <div class="flex items-center">
                    <div class="p-3 rounded-full bg-purple-500/30 text-purple-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-indigo-200">CO₂ Emissions</p>
                        <p class="text-2xl font-bold text-white">128 kg</p>
                    </div>
                </div>
                <div class="mt-4">
                    <div class="h-2 bg-gray-600 rounded-full">
                        <div class="h-2 bg-gradient-to-r from-purple-400 to-pink-500 rounded-full" style="width: 42%"></div>
                    </div>
                </div>
            </div>
            
            <div class="bg-white/10 backdrop-blur-lg rounded-xl shadow-xl p-6 border border-white/20 hover:transform hover:scale-105 transition-all">
                <div class="flex items-center">
                    <div class="p-3 rounded-full bg-pink-500/30 text-pink-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-indigo-200">Efficiency Score</p>
                        <p class="text-2xl font-bold text-white">83%</p>
                    </div>
                </div>
                <div class="mt-4">
                    <div class="h-2 bg-gray-600 rounded-full">
                        <div class="h-2 bg-gradient-to-r from-pink-400 to-red-500 rounded-full" style="width: 83%"></div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Main Charts Section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">
            <!-- Energy Consumption Chart -->
            <div class="bg-white/10 backdrop-blur-lg rounded-xl shadow-xl p-6 border border-white/20">
                <h2 class="text-xl font-bold mb-4">Energy Consumption Trends</h2>
                <div class="h-80 bg-gradient-to-r from-indigo-950/50 to-purple-950/50 rounded-lg p-4 flex items-end justify-between">
                    <% for {month, value} <- [{"Jan", 65}, {"Feb", 59}, {"Mar", 80}, {"Apr", 81}, {"May", 56}, {"Jun", 55}, {"Jul", 40}, {"Aug", 70}, {"Sep", 90}, {"Oct", 75}, {"Nov", 60}, {"Dec", 85}] do %>
                        <div class="flex flex-col items-center w-1/12">
                            <div class="w-full bg-gradient-to-t from-blue-500 to-teal-300 rounded-t-sm"></div>
                            <span class="text-xs mt-2 text-indigo-200"><%= month %></span>
                        </div>
                    <% end %>
                </div>
                <div class="mt-4 flex justify-between text-indigo-200 text-sm">
                    <span>Lower consumption is better for the environment</span>
                    <span>Last updated: Today, 14:30</span>
                </div>
            </div>
            
            <!-- Pollution Metrics Chart -->
            <div class="bg-white/10 backdrop-blur-lg rounded-xl shadow-xl p-6 border border-white/20">
                <h2 class="text-xl font-bold mb-4">Pollution Metrics</h2>
                <div class="h-80 bg-gradient-to-r from-indigo-950/50 to-purple-950/50 rounded-lg p-4 relative">
                    <!-- SVG Line Chart for Pollution -->
                    <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
                        <!-- CO2 Line -->
                        <path d="M0,50 L10,48 L20,55 L30,60 L40,52 L50,45 L60,40 L70,38 L80,42 L90,38 L100,35" 
                                    fill="none" stroke="rgba(236, 72, 153, 0.7)" stroke-width="1" />
                        
                        <!-- NOx Line -->
                        <path d="M0,70 L10,65 L20,68 L30,72 L40,70 L50,65 L60,60 L70,62 L80,58 L90,56 L100,52" 
                                    fill="none" stroke="rgba(96, 165, 250, 0.7)" stroke-width="1" />
                        
                        <!-- Gradient Fill Under CO2 Line -->
                        <path d="M0,50 L10,48 L20,55 L30,60 L40,52 L50,45 L60,40 L70,38 L80,42 L90,38 L100,35 L100,100 L0,100 Z" 
                                    fill="url(#pinkGradient)" opacity="0.3" />
                        
                        <!-- Gradient Fill Under NOx Line -->
                        <path d="M0,70 L10,65 L20,68 L30,72 L40,70 L50,65 L60,60 L70,62 L80,58 L90,56 L100,52 L100,100 L0,100 Z" 
                                    fill="url(#blueGradient)" opacity="0.3" />
                        
                        <!-- Define gradients -->
                        <defs>
                            <linearGradient id="pinkGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" stop-color="rgba(236, 72, 153, 0.7)" />
                                <stop offset="100%" stop-color="rgba(236, 72, 153, 0)" />
                            </linearGradient>
                            
                            <linearGradient id="blueGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" stop-color="rgba(96, 165, 250, 0.7)" />
                                <stop offset="100%" stop-color="rgba(96, 165, 250, 0)" />
                            </linearGradient>
                        </defs>
                    </svg>
                    
                    <!-- Chart Legend -->
                    <div class="absolute top-2 right-2 bg-black/30 backdrop-blur-sm p-2 rounded-lg">
                        <div class="flex items-center mb-1">
                            <div class="w-3 h-3 bg-pink-500 rounded-full mr-2"></div>
                            <span class="text-xs text-pink-300">CO₂ Emissions</span>
                        </div>
                        <div class="flex items-center">
                            <div class="w-3 h-3 bg-blue-500 rounded-full mr-2"></div>
                            <span class="text-xs text-blue-300">NOx Levels</span>
                        </div>
                    </div>
                </div>
                <div class="mt-4 flex justify-between text-indigo-200 text-sm">
                    <span>Downward trends indicate improving air quality</span>
                    <span>Last 12 months</span>
                </div>
            </div>
        </div>
        
        <!-- Bottom Row for Additional Metrics -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Air Quality Index -->
            <div class="bg-white/10 backdrop-blur-lg rounded-xl shadow-xl p-6 border border-white/20">
                <h3 class="text-lg font-bold mb-3">Air Quality Index</h3>
                <div class="flex items-center justify-center">
                    <div class="relative w-40 h-40">
                        <!-- Circular Progress Bar -->
                        <svg class="w-full h-full" viewBox="0 0 100 100">
                            <!-- Background Circle -->
                            <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="8" />
                            
                            <!-- Progress Circle -->
                            <circle cx="50" cy="50" r="45" fill="none" stroke="url(#circleGradient)" stroke-width="8" 
                                            stroke-dasharray="283" stroke-dashoffset="85" transform="rotate(-90 50 50)" />
                            
                            <defs>
                                <linearGradient id="circleGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="0%" stop-color="#34d399" />
                                    <stop offset="100%" stop-color="#3b82f6" />
                                </linearGradient>
                            </defs>
                        </svg>
                        
                        <!-- Central Text -->
                        <div class="absolute inset-0 flex flex-col items-center justify-center">
                            <span class="text-3xl font-bold">72</span>
                            <span class="text-xs text-indigo-200">Good</span>
                        </div>
                    </div>
                </div>
                <div class="mt-4 text-center text-sm text-indigo-200">
                    <p>Better than 65% of monitored areas</p>
                </div>
            </div>
            
            <!-- Energy Sources -->
            <div class="bg-white/10 backdrop-blur-lg rounded-xl shadow-xl p-6 border border-white/20">
                <h3 class="text-lg font-bold mb-3">Energy Sources</h3>
                <div class="space-y-4">
                    <div>
                        <div class="flex justify-between mb-1">
                            <span class="text-sm text-indigo-200">Renewable</span>
                            <span class="text-sm font-medium text-teal-300">42%</span>
                        </div>
                        <div class="h-2 bg-gray-600 rounded-full">
                            <div class="h-2 bg-gradient-to-r from-teal-400 to-teal-500 rounded-full" style="width: 42%"></div>
                        </div>
                    </div>
                    
                    <div>
                        <div class="flex justify-between mb-1">
                            <span class="text-sm text-indigo-200">Natural Gas</span>
                            <span class="text-sm font-medium text-blue-300">35%</span>
                        </div>
                        <div class="h-2 bg-gray-600 rounded-full">
                            <div class="h-2 bg-gradient-to-r from-blue-400 to-blue-500 rounded-full" style="width: 35%"></div>
                        </div>
                    </div>
                    
                    <div>
                        <div class="flex justify-between mb-1">
                            <span class="text-sm text-indigo-200">Coal</span>
                            <span class="text-sm font-medium text-pink-300">18%</span>
                        </div>
                        <div class="h-2 bg-gray-600 rounded-full">
                            <div class="h-2 bg-gradient-to-r from-pink-400 to-pink-500 rounded-full" style="width: 18%"></div>
                        </div>
                    </div>
                    
                    <div>
                        <div class="flex justify-between mb-1">
                            <span class="text-sm text-indigo-200">Nuclear</span>
                            <span class="text-sm font-medium text-purple-300">5%</span>
                        </div>
                        <div class="h-2 bg-gray-600 rounded-full">
                            <div class="h-2 bg-gradient-to-r from-purple-400 to-purple-500 rounded-full" style="width: 5%"></div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Forecast & Recommendations -->
            <div class="bg-white/10 backdrop-blur-lg rounded-xl shadow-xl p-6 border border-white/20">
                <h3 class="text-lg font-bold mb-3">Recommendations</h3>
                <ul class="space-y-3">
                    <li class="flex items-start">
                        <div class="flex-shrink-0 h-6 w-6 rounded-full bg-teal-500/30 text-teal-300 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <span class="ml-2 text-sm text-indigo-200">Reduce peak usage between 5-8PM to save 15%</span>
                    </li>
                    <li class="flex items-start">
                        <div class="flex-shrink-0 h-6 w-6 rounded-full bg-teal-500/30 text-teal-300 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <span class="ml-2 text-sm text-indigo-200">Optimize HVAC system to cut CO₂ by 12kg/month</span>
                    </li>
                    <li class="flex items-start">
                        <div class="flex-shrink-0 h-6 w-6 rounded-full bg-teal-500/30 text-teal-300 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <span class="ml-2 text-sm text-indigo-200">Switch 5 more devices to smart power strips</span>
                    </li>
                    <li class="flex items-start">
                        <div class="flex-shrink-0 h-6 w-6 rounded-full bg-blue-500/30 text-blue-300 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2h-1V9z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <span class="ml-2 text-sm text-indigo-200">Forecast: 8% increase in solar efficiency next month</span>
                    </li>
                </ul>
            </div>
        </div>
        
        <!-- Footer -->
        <div class="mt-12 text-center text-indigo-200 text-sm">
            <p>Real-time energy monitoring and pollution analytics dashboard</p>
            <p class="mt-2">© 2023 IoT Energy Solutions • Updated every 15 minutes</p>
        </div>
    </div>
</div>